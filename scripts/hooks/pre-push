#!/bin/sh
# Freno antes de subir a GitHub.
#
# `CLAUDE.md` describía este hook desde julio, pero el archivo nunca existió y
# `core.hooksPath` apuntaba a una carpeta vacía: git no encontraba nada que
# ejecutar y seguía adelante en silencio. Un freno que no frena es peor que no
# tener freno, porque uno confía en él.
#
# Corre lo que se puede correr sin Docker (~10 s). Las pruebas de base de datos
# (pgTAP) NO van acá: necesitan `supabase start` y tardan minutos. De esas se
# encarga GitHub Actions, y `desplegar.sh` verifica que hayan pasado antes de
# publicar.
#
# Para saltarlo a propósito en una urgencia real:  git push --no-verify

set -e

# Va PRIMERO porque tarda menos de un segundo y porque un número duplicado no se
# arregla corriendo pruebas: se arregla renombrando un archivo. Enterarse antes
# de esperar los diez segundos del typecheck ahorra el viaje entero.
echo "→ numeración de migraciones y pruebas…"
"$(dirname "$0")/numeracion.sh" || exit 1

# También antes del typecheck, y por el mismo motivo: tarda un parpadeo y lo que
# caza no se arregla corriendo pruebas, se arregla con un comando de una línea.
#
# La consulta «qué me falta pegar» lleva dentro la lista de migraciones del repo.
# Esa lista es una copia de algo que ya vive en `supabase/migrations`, y una copia
# que hay que acordarse de actualizar es una copia que va a mentir — el mismo
# patrón que el 2026-08-07 estuvo a una pegada de revertir la 0171 en producción.
#
# `--arregla` y no `--check`: si está vieja, la regenera y la commitea sola, y
# recién entonces aborta pidiendo un segundo push (git ya había calculado qué
# commits enviar antes de llamar a este hook, así que el nuevo no viajaría).
#
# El cambio es del 2026-08-08 y tiene motivo medido: `--check` frenó CUATRO
# pushes en un solo día, siempre para pedir el mismo comando de una línea. Un
# guardián que te para para pedirte algo que él mismo puede hacer enseña que sus
# avisos son trámite — y el día que frene por un número duplicado o una prueba en
# rojo, ya le habrá enseñado a quien lo lee a saltárselo con `--no-verify`.
echo "→ la consulta de qué falta pegar…"
"$(dirname "$0")/../que-falta-pegar.sh" --arregla || exit 1

echo "→ typecheck…"
npx pnpm typecheck >/dev/null 2>&1 || {
  echo ""
  echo "  ✗ El typecheck falló. No se sube."
  echo "    Corre 'npx pnpm typecheck' para ver qué pasa."
  exit 1
}

echo "→ pruebas de interfaz…"
npx pnpm test >/dev/null 2>&1 || {
  echo ""
  echo "  ✗ Las pruebas fallaron. No se sube."
  echo "    Corre 'npx pnpm test' para ver cuál."
  exit 1
}

echo "✓ typecheck y pruebas en verde."
