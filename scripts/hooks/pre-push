#!/bin/sh
# Freno antes de subir a GitHub.
#
# `CLAUDE.md` describía este hook desde julio, pero el archivo nunca existió y
# `core.hooksPath` apuntaba a una carpeta vacía: git no encontraba nada que
# ejecutar y seguía adelante en silencio. Un freno que no frena es peor que no
# tener freno, porque uno confía en él.
#
# Corre lo que se puede correr sin Docker (~10 s). Las pruebas de base de datos
# (pgTAP) NO van acá: necesitan `supabase start` y tardan minutos. De esas se
# encarga GitHub Actions, y `desplegar.sh` verifica que hayan pasado antes de
# publicar.
#
# Para saltarlo a propósito en una urgencia real:  git push --no-verify

set -e

# Va PRIMERO porque tarda menos de un segundo y porque un número duplicado no se
# arregla corriendo pruebas: se arregla renombrando un archivo. Enterarse antes
# de esperar los diez segundos del typecheck ahorra el viaje entero.
echo "→ numeración de migraciones y pruebas…"
"$(dirname "$0")/numeracion.sh" || exit 1

# También antes del typecheck, y por el mismo motivo: tarda un parpadeo y lo que
# caza no se arregla corriendo pruebas, se arregla con un comando de una línea.
#
# La consulta «qué me falta pegar» lleva dentro la lista de migraciones del repo.
# Esa lista es una copia de algo que ya vive en `supabase/migrations`, y una copia
# que hay que acordarse de actualizar es una copia que va a mentir — el mismo
# patrón que el 2026-08-07 estuvo a una pegada de revertir la 0171 en producción.
#
# `--arregla` y no `--check`: si está vieja, la regenera y la commitea sola, y
# recién entonces aborta pidiendo un segundo push (git ya había calculado qué
# commits enviar antes de llamar a este hook, así que el nuevo no viajaría).
#
# El cambio es del 2026-08-08 y tiene motivo medido: `--check` frenó CUATRO
# pushes en un solo día, siempre para pedir el mismo comando de una línea. Un
# guardián que te para para pedirte algo que él mismo puede hacer enseña que sus
# avisos son trámite — y el día que frene por un número duplicado o una prueba en
# rojo, ya le habrá enseñado a quien lo lee a saltárselo con `--no-verify`.
echo "→ la consulta de qué falta pegar…"
"$(dirname "$0")/../que-falta-pegar.sh" --arregla || exit 1

# Una migración sin commitear puede estar YA aplicada en producción, y entonces su
# único ejemplar está en esta Mac. Pasó con la 0177 (2026-08-07) y otra vez con la
# 0243 (2026-08-14), con cuatro pushes en el medio que no dijeron nada.
#
# Va acá, entre los instantáneos y antes del typecheck, porque tarda un parpadeo.
# AVISA Y NO BLOQUEA — el motivo largo está en su cabecera, y es la misma regla
# que la de `types.ts` de abajo: lo que solo está en el disco se avisa, porque
# otra sesión puede estar escribiéndola ahora mismo.
echo "→ migraciones sin guardar…"
"$(dirname "$0")/migracion-sin-guardar.sh" || true

# ── Lo que `main` tiene y esta rama no ──────────────────────────────────────
#
# El 2026-08-20 la 0276 se construyó sobre un cuerpo de `fn_planilla_calcular`
# que ya no era el vigente: otra sesión había fusionado la 0275 a `main` y
# Felipe la había pegado. `donde-vive.sh` y `db reset` no lo vieron porque los
# dos miran el worktree, y el worktree no la tenía. Lo cazó el md5 de
# producción, o sea el último freno, con el trabajo ya hecho y commiteado.
#
# AVISA, no bloquea: ir por detrás de `main` es un estado legítimo y constante
# con varias sesiones en paralelo. Sube el tono solo cuando las migraciones que
# faltan tocan las MISMAS funciones que las tuyas, que es el caso que hace daño.
echo "→ lo que main tiene y tú no…"
"$(dirname "$0")/main-tiene-migraciones-que-no-tienes.sh" || true

# ── Las reglas del CLAUDE.md, preguntadas en vez de recordadas ──────────────
#
# La auditoría de agosto de 2026 encontró diez comparaciones de `rol` contra un
# literal fuera de `permisos.ts` y tres `"America/Lima"` fuera de
# `fecha-lima.ts` — las dos reglas están escritas, y las dos se escribieron
# DESPUÉS de juntar 35 y 32 copias respectivamente. El documento no falló por
# estar mal escrito: falló porque un documento es memoria, y aquí trabajan
# varias sesiones a la vez.
#
# Va acá, con los instantáneos y antes del typecheck, porque tarda un parpadeo.
# BLOQUEA, a diferencia de los dos de arriba, y la distinción es la que este
# hook ya tenía escrita: esto habla de lo que SALE hacia GitHub, no del disco.
echo "→ las reglas de la casa…"
"$(dirname "$0")/reglas-de-la-casa.sh" || exit 1

# ── El linter, pero solo sobre lo que este push agrega ─────────────────────
#
# ESLint llevaba instalado y apagado desde julio. La auditoría de agosto lo
# encontró con 119 errores; una semana después eran 131. Creció en doce sin que
# nadie lo notara, que es lo que le pasa a un guardián que nadie enciende.
#
# Mismo criterio que el de arriba y que numeracion.sh: solo juzga lo que el push
# AÑADE. Los errores viejos no frenan a nadie; el 132 no entra.
#
# Es barato porque no lintea el repositorio entero: solo los archivos que el
# push modifica, y si no toca ningún .ts ni .tsx sale en un parpadeo — que aquí
# es lo normal, porque la mayoría de los push son SQL.
echo "→ el linter, sobre lo nuevo…"
"$(dirname "$0")/lint-de-lo-nuevo.sh" || exit 1

# ── Los tipos generados, que no pueden viajar vacíos ────────────────────────
#
# `packages/database/src/types.ts` lo escribe `gen-types` de un tirón: si el
# comando falla a media ejecución, deja el archivo en CERO LÍNEAS. El 2026-08-08
# se encontró exactamente así, y tumbaba el typecheck de todo el repositorio con
# «File types.ts is not a module» — un mensaje que no dice ni qué pasó ni qué
# hacer.
#
# ESTO NO CIERRA UN AGUJERO, y conviene ser honesto: el typecheck de más abajo ya
# lo cazaba. Lo que aporta es llegar antes —es instantáneo, el typecheck tarda
# diez segundos— y decir en castellano qué pasó y con qué comando se arregla.
#
# LA DISTINCIÓN QUE IMPORTA, y es la lección que este repositorio pagó tres veces
# el mismo día: un freno tiene que hablar de lo que SALE de esta máquina, no de
# lo que hay en el disco.
#
#   · vacío en lo que se EMPUJA  → se bloquea. Eso rompe el repo de cualquiera
#     que lo clone, y es un defecto real que viaja.
#   · vacío solo en el disco     → se avisa y se sigue. Molesta a quien lo tenga
#     a medio regenerar, pero su push no lo lleva. Frenar ahí sería castigar por
#     algo ajeno, que es como se le enseña a la gente a usar `--no-verify`.
TIPOS="packages/database/src/types.ts"
if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  # Lo que este push llevaría: si no lo toca, `git show` falla y no hay nada que
  # comprobar.
  LINEAS_PUSH=$(git show "HEAD:$TIPOS" 2>/dev/null | grep -c . || echo "")
  if [ -n "$LINEAS_PUSH" ] && [ "$LINEAS_PUSH" -lt 100 ]; then
    echo ""
    echo "  ✗ $TIPOS viaja con solo $LINEAS_PUSH líneas."
    echo "    Es un archivo generado: si quedó a medias, el repo no compila para"
    echo "    nadie que lo clone. Regenéralo y vuelve a commitear:"
    echo ""
    echo "      npx pnpm --filter @cayla-dynamic/database gen-types"
    echo ""
    exit 1
  fi
fi
if [ -f "$TIPOS" ] && [ "$(grep -c . "$TIPOS")" -lt 100 ]; then
  echo "  ⚠ $TIPOS está casi vacío EN TU DISCO (no en lo que empujas)."
  echo "    Alguien lo está regenerando. Tu typecheck local va a fallar hasta que termine."
fi

echo "→ typecheck…"
npx pnpm typecheck >/dev/null 2>&1 || {
  echo ""
  echo "  ✗ El typecheck falló. No se sube."
  echo "    Corre 'npx pnpm typecheck' para ver qué pasa."
  exit 1
}

echo "→ pruebas de interfaz…"
npx pnpm test >/dev/null 2>&1 || {
  echo ""
  echo "  ✗ Las pruebas fallaron. No se sube."
  echo "    Corre 'npx pnpm test' para ver cuál."
  exit 1
}

echo "✓ typecheck y pruebas en verde."
